# Port d'écoute du serveur
PORT=3000

# Mot de passe du dashboard admin (/admin)
ADMIN_PASSWORD=changeme

# Valeur initiale de l'URL encodée dans le QR Code (modifiable ensuite dans l'admin)
# En production : PUBLIC_URL=https://revelio.ltn.re/play
#PUBLIC_URL=

# Répertoire de stockage des images uploadées (volume Docker)
UPLOAD_DIR=/data/uploads
